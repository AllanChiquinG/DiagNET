<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Servidor.Negocio\Servidor.Negocio.csproj" />
    <ProjectReference Include="..\Servidor.Datos\Servidor.Datos.csproj" />
    <ProjectReference Include="..\Servidor.Integracion\Servidor.Integracion.csproj" />
    <ProjectReference Include="..\Compartido.Contratos\Compartido.Contratos.csproj" />
    <ProjectReference Include="..\Cliente.Web\Cliente.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <!-- Los secretos locales NUNCA viajan en la publicación: se entregan por variables de entorno o por un archivo aparte junto al despliegue. -->
    <Content Remove="appsettings.Local.json" />
    <None Include="appsettings.Local.json" Condition="Exists('appsettings.Local.json')" CopyToPublishDirectory="Never" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
