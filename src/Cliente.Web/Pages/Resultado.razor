@page "/resultado/{IdTexto}"
@using Compartido.Contratos
@using Cliente.Web.Componentes
@using Cliente.Web.Servicios
@inject ClienteApi Api
@inject ConfiguracionCliente Configuracion
@inject AlmacenHistorial Historial
@inject AvisosSesion Avisos
@inject IServicioNavegador Navegador

<PageTitle>@(analisis is null ? "Resultado" : analisis.NombreArchivo) · DiagNET</PageTitle>

@if (estado == Estado.Cargando)
{
    <div class="card empty" role="status" aria-busy="true">
        <h1 tabindex="-1">Abriendo el análisis…</h1>
        <p class="muted">Se muestra el resultado guardado; no se vuelve a consultar NuGet.</p>
    </div>
}
else if (estado == Estado.NoDisponible)
{
    @* P8: análisis no disponible (enlace incorrecto, eliminado o caducado). El servidor no distingue las causas, y no se afirma ninguna. *@
    <MensajeError Titulo="Este análisis ya no está disponible"
                  Parrafos="@(new[] { $"El enlace no es correcto, el análisis ya no existe o superó el plazo de conservación{(retencionDias is { } d ? $" ({d} días)" : "")} y se eliminó.", "Puedes hacer un análisis nuevo con el mismo archivo." })"
                  Referencia="@referenciaError">
        <a class="btn pri" href="">Nuevo análisis</a>
        <a class="btn sec" href="historial">Ver historial</a>
        @if (enHistorial && id is not null)
        {
            <button type="button" class="btn link" @onclick="QuitarDelHistorial">Quitar de mi historial</button>
        }
    </MensajeError>
}
else if (estado == Estado.Error)
{
    <MensajeError Titulo="No pudimos abrir el análisis"
                  Parrafos="@(new[] { errorApi?.Status == 0 ? "No pudimos contactar con el servidor. Revisa tu conexión." : "Ocurrió un problema en el servidor. El análisis no se ha perdido.", "Inténtalo de nuevo en unos minutos." })"
                  Referencia="@errorApi?.Referencia">
        <button type="button" class="btn pri" @onclick="Cargar">Reintentar</button>
        <a class="btn sec" href="historial">Ver historial</a>
    </MensajeError>
}
else if (analisis is not null)
{
    <div class="head">
        <div>
            <div class="crumb"><a href="">Nuevo análisis</a> › Resultado</div>
            <h1 class="titulo-resultado" tabindex="-1">@analisis.NombreArchivo</h1>
            <div class="chips">
                <span class="chip">@(analisis.FrameworksDeclarados.Count == 0 ? "Framework no declarado" : string.Join(" · ", analisis.FrameworksDeclarados))</span>
                @if (analisis.FrameworksEvaluados.Count != analisis.FrameworksDeclarados.Count)
                {
                    <span class="chip">@(analisis.FrameworksEvaluados.Count == 0 ? "Ningún framework evaluable" : "Evaluados: " + string.Join(" · ", analisis.FrameworksEvaluados))</span>
                }
                <span class="chip">@analisis.Dependencias.Count @(analisis.Dependencias.Count == 1 ? "dependencia" : "dependencias")</span>
                <span class="chip">Analizado el @Presentacion.Fecha(analisis.FechaAnalisis)</span>
                <span class="badge @(analisis.Estado == EstadoAnalisis.Parcial ? "part" : "full")">@Presentacion.Texto(analisis.Estado)</span>
            </div>
        </div>
        <div class="acts">
            <a class="btn sec" href="">Nuevo análisis</a>
            <button type="button" class="btn sec" @onclick="CopiarEnlace">Copiar enlace</button>
            @* El PDF corresponde a una entrega posterior: la acción se muestra con su explicación y no simula ninguna descarga. *@
            <button type="button" class="btn pri sin-efecto" aria-disabled="true" aria-describedby="pdf-nota">Exportar PDF</button>
        </div>
    </div>
    <p id="pdf-nota" class="note nota-pdf">El reporte en PDF todavía no está disponible; se habilitará en una próxima versión. Por ahora puedes copiar el enlace de este resultado.</p>
    <div class="vh" role="status" aria-live="polite">@mensajeEnlace</div>
    @if (!string.IsNullOrEmpty(mensajeEnlace))
    {
        <div class="toast good" aria-hidden="true">@mensajeEnlace</div>
    }

    @if (Avisos.HistorialNoGuardado && Avisos.IdSinGuardar == id)
    {
        <div class="alert warn banner" role="status">
            <div>
                <b>Este análisis no se pudo guardar en el historial de este navegador</b>
                <div>El almacenamiento local no está disponible o está lleno. Guarda el enlace de esta página para volver a abrirlo; cualquiera que tenga el enlace podrá verlo.</div>
            </div>
        </div>
    }

    <AvisosAnalisis Estado="analisis.Estado" Advertencias="@AvisosGenerales" />

    <ContadoresEstado Resumen="Resumen" @bind-Filtro="filtro" />

    <TablaDiagnosticos Dependencias="analisis.Dependencias" Filtro="filtro" @bind-MostrarTodas="mostrarTodas" AlSeleccionar="Abrir" />

    <p class="note">
        Resultado guardado el @Presentacion.Fecha(analisis.FechaAnalisis). Cada librería indica el origen y la fecha de sus datos. El resultado no cambia aunque NuGet publique nuevas versiones; para verlas, haz un nuevo análisis.
        Se conserva @analisis.RetencionDias días. Cualquier persona con el enlace puede abrirlo; no es una cuenta privada.
        <span class="reglas">Reglas: <span class="mono">@analisis.VersionReglas</span></span>
    </p>

    @if (!enHistorial && almacenamientoDisponible)
    {
        <p class="note"><button type="button" class="btn link" @onclick="GuardarEnHistorial">Guardar en el historial de este navegador</button></p>
    }

    @if (seleccion is not null)
    {
        <PanelDetalle @key="seleccion" Dependencia="seleccion" Disparador="@disparador" AlCerrar="Cerrar" />
    }
}

@code {
    private enum Estado { Cargando, Listo, NoDisponible, Error }

    private Estado estado = Estado.Cargando;
    private Guid? id;
    private ResultadoAnalisisDto? analisis;
    private ErrorApi? errorApi;
    private string? referenciaError;
    private int? retencionDias;
    private EstadoDiagnostico? filtro;
    private bool mostrarTodas;
    private DependenciaAnalizadaDto? seleccion;
    private string? disparador;
    private string? mensajeEnlace;
    private bool enHistorial;
    private bool almacenamientoDisponible;
    private string? idCargado;

    [Parameter] public string IdTexto { get; set; } = "";

    private ResumenEstadosDto Resumen => ResumenEstadosDto.Calcular(analisis!.Dependencias);

    // Los avisos de recomendaciones que no se evaluaron por completo se muestran siempre, aunque el diagnóstico esté completo.
    private IReadOnlyList<AdvertenciaDto> AvisosGenerales => analisis!.Advertencias;

    protected override async Task OnParametersSetAsync()
    {
        if (idCargado == IdTexto) return;
        idCargado = IdTexto;
        await Cargar();
    }

    private async Task Cargar()
    {
        estado = Estado.Cargando;
        analisis = null;
        seleccion = null;
        filtro = null;
        mostrarTodas = false;
        errorApi = null;
        referenciaError = null;
        mensajeEnlace = null;

        if (!Guid.TryParseExact(IdTexto, "D", out var guid))
        {
            id = null;
            retencionDias = (await Configuracion.ObtenerAsync())?.RetencionDias;
            estado = Estado.NoDisponible;
            return;
        }

        id = guid;
        var almacen = await Historial.CargarAsync();
        almacenamientoDisponible = almacen.Disponible;
        enHistorial = almacen.Entradas.Any(e => e.Id == guid);

        var respuesta = await Api.ObtenerAnalisisAsync(guid);
        if (respuesta.Ok)
        {
            analisis = respuesta.Valor;
            retencionDias = analisis!.RetencionDias;
            estado = Estado.Listo;
            return;
        }

        errorApi = respuesta.Error;
        if (errorApi!.EsNoEncontrado)
        {
            retencionDias = (await Configuracion.ObtenerAsync())?.RetencionDias;
            estado = Estado.NoDisponible;
        }
        else
        {
            referenciaError = errorApi.Referencia;
            estado = Estado.Error;
        }
    }

    private Task Abrir((DependenciaAnalizadaDto Dependencia, string Disparador) valor)
    {
        seleccion = valor.Dependencia;
        disparador = valor.Disparador;
        return Task.CompletedTask;
    }

    private void Cerrar() => seleccion = null;

    private async Task CopiarEnlace()
    {
        var ok = await Navegador.CopiarAsync(await Navegador.DireccionActualAsync());
        mensajeEnlace = ok ? "Enlace copiado" : "No se pudo copiar el enlace. Cópialo desde la barra de direcciones.";
    }

    private async Task GuardarEnHistorial()
    {
        if (analisis is null) return;
        enHistorial = await Historial.AgregarAsync(new EntradaLocal(analisis.Id, analisis.NombreArchivo, analisis.FechaAnalisis));
        mensajeEnlace = enHistorial ? "Guardado en el historial de este navegador" : "No se pudo guardar en el historial de este navegador.";
    }

    private async Task QuitarDelHistorial()
    {
        if (id is not { } guid) return;
        await Historial.QuitarAsync(guid);
        enHistorial = false;
    }
}
