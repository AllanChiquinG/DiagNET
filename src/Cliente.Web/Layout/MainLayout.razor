@inherits LayoutComponentBase

<a class="skip" href="#contenido">Saltar al contenido</a>
<header class="top">
    <div class="wrap top-in">
        <a class="brand" href="" aria-label="DiagNET, ir al inicio">
            <span class="logo" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" focusable="false"><circle cx="10.5" cy="10.5" r="6" /><path d="M8 10.5l1.8 1.8 3.2-3.6M15 15l5 5" /></svg>
            </span>
            <span>DiagNET<small>Diagnóstico de librerías .NET</small></span>
        </a>
        <nav class="nav" aria-label="Principal">
            <NavLink href="" Match="NavLinkMatch.All" ActiveClass="on">Nuevo análisis</NavLink>
            <NavLink href="historial" ActiveClass="on">Historial</NavLink>
        </nav>
        <span class="sp"></span>
        <span class="tag">.NET 8 · .NET 10</span>
    </div>
</header>
<main id="contenido" class="wrap" tabindex="-1">@Body</main>
<footer class="pie">
    <div class="wrap">
        <span>Proyecto de graduación · Ingeniería en Sistemas</span>
        <span>Cada librería indica de dónde y de cuándo son sus datos de NuGet</span>
    </div>
</footer>
