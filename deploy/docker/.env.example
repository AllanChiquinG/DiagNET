# Copia este archivo como «.env» (NO se versiona) y reemplaza los valores. Ningún valor real debe escribirse aquí.
POSTGRES_PASSWORD=REEMPLAZA_ESTA_CONTRASENA_LARGA_Y_UNICA
# «localhost» para probar en este equipo; un dominio real solo cuando el propietario decida publicar.
DIAGNET_DOMINIO=localhost
# 127.0.0.1 = solo este equipo (por defecto). 0.0.0.0 expondría el proxy en la red/Internet: requiere decisión y autorización del propietario.
DIAGNET_PUBLICAR_IP=127.0.0.1
